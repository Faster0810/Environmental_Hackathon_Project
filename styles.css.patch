--- frontend/styles.css
+++ frontend/styles.css
@@ -749,3 +749,43 @@
 ::-webkit-scrollbar-thumb { background: rgba(105, 240, 174, 0.3); border-radius: 6px; border: 2px solid var(--bg-dark); }
 ::-webkit-scrollbar-thumb:hover { background: rgba(105, 240, 174, 0.6); }
 
+/* --- New Feature Layouts --- */
+.resource-grid {
+    display: grid;
+    grid-template-columns: 1fr 1fr;
+    gap: 20px;
+    align-items: center;
+}
+@media (max-width: 768px) {
+    .resource-grid { grid-template-columns: 1fr; }
+    .score-display { flex-direction: column; text-align: center; }
+}
+.r-chart {
+    height: 250px;
+    position: relative;
+    background: rgba(0, 0, 0, 0.2);
+    border-radius: 12px;
+    padding: 10px;
+}
+.incident-board { display: flex; flex-direction: column; gap: 16px; }
+.incident-form {
+    display: flex; flex-direction: column; gap: 10px;
+    background: rgba(0,0,0,0.3); padding: 16px; border-radius: 12px;
+}
+.incident-input {
+    padding: 12px; border-radius: 8px; border: 1px solid var(--card-border);
+    background: rgba(0,0,0,0.5); color: var(--text-primary); font-family: var(--font-main);
+}
+.incident-list { display: flex; flex-direction: column; gap: 10px; }
+.incident-item {
+    display: flex; justify-content: space-between; align-items: center;
+    background: rgba(255, 82, 82, 0.1); border: 1px solid var(--danger-color);
+    padding: 12px 16px; border-radius: 8px; color: #ffcdd2;
+}
+.resolve-btn {
+    margin-top: 0; width: auto; padding: 8px 16px;
+    background: linear-gradient(135deg, #4CAF50 0%, #45a049 100%);
+    font-size: 13px; color: white; box-shadow: none;
+}
+.resolve-btn:hover { background: linear-gradient(135deg, #66bb6a 0%, #4caf50 100%); }
